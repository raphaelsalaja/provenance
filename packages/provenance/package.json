{
  "name": "@web-kits/provenance",
  "version": "0.2.1",
  "description": "A product-neutral specification and reference CLI for recording research and design provenance.",
  "type": "module",
  "bin": {
    "provenance": "src/cli.js"
  },
  "files": [
    "examples/minimal",
    "LICENSES",
    "schema",
    "spec",
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "provenance": "node src/cli.js",
    "check": "pnpm sync:skill:check && node --test && node src/cli.js check examples/minimal/.provenance/provenance.yaml && node src/cli.js check examples/relationships/.provenance/provenance.yaml && node src/cli.js check examples/entities/.provenance && pnpm generate:check",
    "test": "node --test",
    "generate:examples": "node scripts/generate-examples.js",
    "generate:check": "node scripts/check-generated.js",
    "sync:skill": "node scripts/sync-skill.js",
    "sync:skill:check": "node scripts/sync-skill.js --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/provenance.git",
    "directory": "packages/provenance"
  },
  "homepage": "https://github.com/raphaelsalaja/provenance#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/provenance/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "provenance",
    "open-source",
    "research",
    "attribution",
    "w3c-prov"
  ],
  "license": "(MIT AND CC-BY-4.0)",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.27.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  }
}
