{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raphaelsalaja/provenance/v0.1.0/schema/provenance.schema.json",
  "title": "Provenance document",
  "description": "A record of sources and their relationships to project artifacts and decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "sources", "relationships"],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "enum": ["sha256", "sha384", "sha512"]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["verified", "unknown", "restricted", "not-applicable"]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "terms"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "article",
            "book",
            "dataset",
            "design",
            "documentation",
            "media",
            "model",
            "paper",
            "personal-communication",
            "repository",
            "software",
            "standard",
            "webpage",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/creator"
          }
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "datePublished": {
          "type": "string",
          "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"
        },
        "dateAccessed": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "archiveUrl": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        },
        "terms": {
          "$ref": "#/$defs/terms"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "anyOf": [
        {
          "properties": {
            "url": {}
          },
          "required": ["url"]
        },
        {
          "properties": {
            "archiveUrl": {}
          },
          "required": ["archiveUrl"]
        },
        {
          "properties": {
            "type": {
              "const": "personal-communication"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locator"],
      "properties": {
        "type": {
          "enum": ["commit", "pull-request", "issue", "file", "release", "other"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "type", "targets", "contribution"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": ["consulted", "inspired", "adapted", "copied", "bundled", "verified"]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contribution": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": ["verified", "inferred", "unknown"]
        },
        "recordedAt": {
          "type": "string",
          "format": "date"
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]*/[A-Za-z0-9._-]+$"
      },
      "additionalProperties": true
    }
  }
}
